---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Tsuki Mel Tattoo | Neo-Traditional Tattoo Artist, Edinburgh',
  description = 'Melissa Hall (Tsuki Mel) - Neo-Traditional & Traditional tattoo artist in Leith, Edinburgh. Custom designs infused with fantasy and gaming references. LGBTQ+ inclusive.',
  image = '/og-image.jpg',
  type = 'website',
} = Astro.props;

const SITE_URL = Astro.site ?? new URL('https://tsuki.tattoo');
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const ogImageURL = new URL(image, SITE_URL);
const personId = new URL('#person', SITE_URL).toString();
// Using The Burrow's own URL as @id signals to Google that this is the
// same entity described on their site, so the citations reinforce
// rather than fragment.
const studioId = 'https://www.theburrowtattoo.co.uk/#tattooparlor';

// Schema.org structured data — @graph with Person (Melissa Hall, the
// brand "Tsuki Mel Tattoo") and the TattooParlor where she works
// (The Burrow Tattoo, Leith). Linking the Person to a Place with a
// full street address is what powers local-pack ranking for queries
// like "tattoo artist Leith" / "neo-traditional tattoo Edinburgh".
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Melissa Hall',
      alternateName: 'Tsuki Mel',
      jobTitle: 'Tattoo Artist',
      description:
        'Neo-Traditional and Traditional tattoo artist, resident at The Burrow Tattoo in Leith, Edinburgh. Custom designs rooted in fantasy and gaming worlds.',
      image: ogImageURL.toString(),
      url: SITE_URL.toString(),
      email: 'tsukimeltattoos@gmail.com',
      alumniOf: {
        '@type': 'EducationalOrganization',
        name: 'BA Concept Art for Video Games and Animation',
      },
      knowsAbout: [
        'Neo-Traditional tattoo',
        'Traditional tattoo',
        'Black and grey tattoo',
        'Tattoo flash',
        'Pop culture tattoo',
        'Video game tattoo',
        'Concept art',
        'Custom tattoo design',
      ],
      workLocation: { '@id': studioId },
      sameAs: ['https://instagram.com/tsuki_melx'],
    },
    {
      '@type': 'TattooParlor',
      '@id': studioId,
      name: 'The Burrow Tattoo',
      url: 'https://www.theburrowtattoo.co.uk/',
      email: 'theburrowtattoo@hotmail.com',
      priceRange: '££',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '54 Timber Bush',
        addressLocality: 'Leith',
        addressRegion: 'Edinburgh',
        postalCode: 'EH6 6QH',
        addressCountry: 'GB',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 55.976575,
        longitude: -3.168405,
      },
      areaServed: [
        { '@type': 'City', name: 'Edinburgh' },
        { '@type': 'AdministrativeArea', name: 'Scotland' },
      ],
      sameAs: [
        'https://www.instagram.com/theburrowedinburgh/',
        'https://share.google/8CCbeZrJjnDxnPdmo',
      ],
    },
  ],
};

// JSON-LD must escape any `<` to prevent breaking out of the script tag
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Primary SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="Melissa Hall (Tsuki Mel)" />
    <meta name="keywords" content="neo-traditional tattoo Edinburgh, traditional tattoo Edinburgh, tattoo artist Leith, tattoo artist Edinburgh, fantasy tattoo, gaming tattoo, video game tattoo, LGBTQ+ tattoo artist Edinburgh, female tattoo artist Edinburgh, tattoo flash Edinburgh, Melissa Hall, Tsuki Mel" />
    <meta name="robots" content="index, follow, max-image-preview:large, noai, noimageai" />
    <meta name="googlebot" content="noai, noimageai" />
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Geo / local SEO -->
    <meta name="geo.region" content="GB-EDH" />
    <meta name="geo.placename" content="Leith, Edinburgh" />
    <meta name="geo.position" content="55.976575;-3.168405" />
    <meta name="ICBM" content="55.976575, -3.168405" />

    <!-- Open Graph (Facebook, LinkedIn, Discord, iMessage) -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Tsuki Mel Tattoo - custom tattoo artist in Leith, Edinburgh" />
    <meta property="og:site_name" content="Tsuki Mel Tattoo" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Browser UX -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14101c" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Structured data (Schema.org TattooParlor) -->
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Raleway:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Sitemap discoverability -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body class="font-body text-cream antialiased">
    <slot />
    <script>
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
        );
        items.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
