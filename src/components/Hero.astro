---
import InkDivider from './InkDivider.astro';
import { BOOKING_URL } from '../constants';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Background gradient -->
  <div class="absolute inset-0 bg-linear-to-br from-aubergine-light via-aubergine to-aubergine"></div>

  <!-- Decorative glow orbs -->
  <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] bg-lavender-dark/15 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-lavender/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-rose-dust/8 rounded-full blur-[80px] pointer-events-none"></div>

  <!-- Celestial decoration: detailed crescent moon (tsuki = moon) -->
  <svg class="absolute top-8 right-4 md:top-12 md:right-12 w-72 h-72 md:w-[30rem] md:h-[30rem] opacity-[0.55] pointer-events-none" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <radialGradient id="hero-moon-halo" cx="50%" cy="50%" r="50%">
        <stop offset="45%" stop-color="#c8b6d6" stop-opacity="0"/>
        <stop offset="62%" stop-color="#c8b6d6" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#c8b6d6" stop-opacity="0"/>
      </radialGradient>
      <mask id="hero-moon-mask">
        <rect width="200" height="200" fill="white"/>
        <circle cx="123" cy="80" r="62" fill="black"/>
      </mask>
    </defs>

    <!-- Soft outer halo -->
    <circle cx="100" cy="100" r="92" fill="url(#hero-moon-halo)"/>

    <!-- Crescent moon body -->
    <circle cx="100" cy="100" r="66" fill="#f5e8d4" mask="url(#hero-moon-mask)"/>

    <!-- Crater stippling on the crescent -->
    <g fill="#9d87b5" opacity="0.55" mask="url(#hero-moon-mask)">
      <circle cx="78" cy="78" r="3.6"/>
      <circle cx="60" cy="102" r="2.6"/>
      <circle cx="82" cy="128" r="2.4"/>
      <circle cx="55" cy="128" r="1.6"/>
      <circle cx="70" cy="150" r="2.2"/>
      <circle cx="48" cy="108" r="1.4"/>
      <circle cx="62" cy="145" r="1.5"/>
      <circle cx="90" cy="115" r="1.8"/>
    </g>

    <!-- Subtle inner highlight along the crescent's inner edge -->
    <path d="M 100,38 A 62,62 0 0 1 100,162 A 50,55 0 0 0 100,38 Z"
          fill="none" stroke="#f5e8d4" stroke-width="0.6" opacity="0.4"
          mask="url(#hero-moon-mask)"/>
  </svg>

  <!-- Stars decoration -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Top band -->
    <span class="absolute top-[5%] left-[7%] text-lavender text-sm opacity-60">✦</span>
    <span class="absolute top-[9%] left-[19%] text-cream text-xs opacity-45">✧</span>
    <span class="absolute top-[4%] left-[34%] text-rose-dust text-xs opacity-40">⋆</span>
    <span class="absolute top-[8%] left-[48%] text-cream text-sm opacity-55">✦</span>
    <span class="absolute top-[6%] left-[62%] text-lavender text-xs opacity-50">⋆</span>
    <span class="absolute top-[11%] right-[26%] text-rose-dust text-xs opacity-45">✧</span>

    <!-- Left side -->
    <span class="absolute top-[22%] left-[5%] text-cream text-xs opacity-50">⋆</span>
    <span class="absolute top-[34%] left-[10%] text-lavender text-sm opacity-55">✦</span>
    <span class="absolute top-[46%] left-[4%] text-rose-dust text-xs opacity-45">✧</span>
    <span class="absolute top-[58%] left-[8%] text-cream text-sm opacity-60">✦</span>
    <span class="absolute top-[72%] left-[5%] text-lavender text-xs opacity-50">⋆</span>
    <span class="absolute top-[82%] left-[15%] text-rose-dust text-xs opacity-40">✧</span>

    <!-- Right side -->
    <span class="absolute top-[28%] right-[7%] text-cream text-xs opacity-50">✦</span>
    <span class="absolute top-[42%] right-[4%] text-lavender text-sm opacity-55">⋆</span>
    <span class="absolute top-[56%] right-[10%] text-rose-dust text-xs opacity-45">✧</span>
    <span class="absolute top-[68%] right-[5%] text-cream text-sm opacity-60">✦</span>
    <span class="absolute top-[80%] right-[14%] text-lavender text-xs opacity-50">⋆</span>

    <!-- Bottom band -->
    <span class="absolute bottom-[16%] left-[20%] text-rose-dust text-xs opacity-45">✦</span>
    <span class="absolute bottom-[8%] left-[32%] text-cream text-xs opacity-50">⋆</span>
    <span class="absolute bottom-[12%] left-[48%] text-lavender text-sm opacity-55">✧</span>
    <span class="absolute bottom-[6%] right-[42%] text-cream text-xs opacity-45">✦</span>
    <span class="absolute bottom-[14%] right-[28%] text-rose-dust text-xs opacity-50">⋆</span>
    <span class="absolute bottom-[9%] right-[18%] text-lavender text-xs opacity-55">✧</span>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">

    <p class="text-lavender text-xs tracking-[0.4em] uppercase mb-6 font-body font-medium">
      Custom Tattoo Artist
    </p>

    <h1 class="font-heading font-light leading-none mb-4">
      <span class="block text-7xl md:text-[8rem] lg:text-[10rem] text-cream tracking-tight">
        Tsuki Mel
      </span>
      <span class="block font-script text-5xl md:text-6xl text-transparent bg-clip-text bg-linear-to-r from-lavender via-cream to-rose-dust mt-4">
        Tattoo
      </span>
    </h1>

    <p class="text-cream/60 text-base md:text-lg font-body font-light mt-10 mb-2 max-w-md mx-auto leading-relaxed">
      Neo-Traditional & Traditional tattoos infused with pop culture and gaming.
    </p>
    <p class="text-lavender/70 text-xs tracking-[0.3em] uppercase mb-10 font-body">
      Leith, Edinburgh
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={BOOKING_URL}
        class="bg-linear-to-r from-lavender-dark to-rose-dust text-aubergine px-10 py-4 rounded-full text-sm tracking-widest uppercase font-medium hover:scale-105 hover:shadow-xl hover:shadow-lavender-dark/40 transition-all duration-300"
      >
        Enquire Now
      </a>
      <a
        href="#black-grey"
        class="border border-lavender/30 text-cream/80 hover:text-cream hover:border-lavender/60 px-10 py-4 rounded-full text-sm tracking-widest uppercase transition-all duration-300"
      >
        View My Work
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <a href="#about" class="absolute bottom-16 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 text-lavender text-sm tracking-widest uppercase animate-bounce hover:text-cream transition-colors">
    <span>Scroll</span>
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </a>

  <InkDivider fillColor="#3a2b4d" />

</section>
