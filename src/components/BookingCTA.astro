---
// Replace with your actual booking link
const BOOKING_URL = 'https://forms.gle/32DTHRxMXCdefBy57';
const INSTAGRAM_URL = 'https://instagram.com/tsuki_melx';
---

<section id="booking" class="relative bg-linear-to-b from-aubergine-light to-aubergine py-32 px-6 overflow-hidden">

  <!-- Glow effects -->
  <div class="absolute top-0 left-1/4 w-[500px] h-[400px] bg-lavender-dark/20 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[300px] bg-rose-dust/15 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-lavender/10 rounded-full blur-[80px] pointer-events-none"></div>

  <!-- Stars -->
  <div class="absolute inset-0 pointer-events-none opacity-25" aria-hidden="true">
    <span class="absolute top-[15%] left-[20%] text-lavender text-xs">✦</span>
    <span class="absolute bottom-[20%] right-[15%] text-cream text-sm">✧</span>
    <span class="absolute top-[40%] right-[25%] text-rose-dust text-xs">✦</span>
  </div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">

    <p class="font-script text-3xl text-lavender mb-2">Get in Touch</p>

    <h2 class="font-heading text-6xl md:text-7xl font-light text-cream leading-tight mb-6">
      Ready to get<br />
      <span class="font-script text-transparent bg-clip-text bg-linear-to-r from-lavender via-cream to-rose-dust">inked?</span>
    </h2>

    <p class="text-cream/60 font-body font-light text-base mb-10 leading-relaxed">
      I take a limited number of bookings each month to ensure every piece gets
      the time and care it deserves. Drop me an email or DM to get started.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={BOOKING_URL}
        class="bg-linear-to-r from-lavender-dark to-rose-dust text-aubergine px-12 py-4 rounded-full text-sm tracking-widest uppercase font-medium hover:scale-105 hover:shadow-xl hover:shadow-lavender-dark/40 transition-all duration-300"
      >
        Enquire Now
      </a>
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-lavender/30 text-cream/80 hover:text-cream hover:border-lavender/60 px-12 py-4 rounded-full text-sm tracking-widest uppercase transition-all duration-300 flex items-center gap-2 justify-center"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        Follow on Instagram
      </a>
    </div>

  </div>

</section>
