---
import { INSTAGRAM_URL } from '../constants';
import InstagramIcon from './InstagramIcon.astro';

const BOOKING_ANCHOR = '#booking';
const currentYear = new Date().getFullYear();
---

<footer class="bg-aubergine border-t border-lavender/15 py-12 px-6">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col md:flex-row items-center justify-between gap-8">

      <!-- Brand -->
      <div class="text-center md:text-left">
        <p class="font-script text-4xl text-cream leading-none">Tsuki Mel Tattoo</p>
        <p class="text-cream/40 text-xs tracking-widest uppercase mt-2 font-body">Custom Tattoo Artist · Leith, Edinburgh</p>
      </div>

      <!-- Nav links -->
      <div class="flex flex-wrap justify-center gap-6 text-xs tracking-widest uppercase text-cream/50">
        <a href="#about" class="hover:text-lavender transition-colors">About</a>
        <a href="#black-grey" class="hover:text-lavender transition-colors">Black & Grey</a>
        <a href="#colour" class="hover:text-lavender transition-colors">Colour</a>
        <a href="#flash" class="hover:text-lavender transition-colors">Flash</a>
        <a href={BOOKING_ANCHOR} class="hover:text-lavender transition-colors">Book</a>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-4">
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="w-10 h-10 rounded-full border border-lavender/30 flex items-center justify-center text-cream/60 hover:text-lavender hover:border-lavender/60 hover:bg-lavender/10 transition-all"
        >
          <InstagramIcon />
        </a>
      </div>

    </div>

    <div class="mt-10 pt-6 border-t border-lavender/10 text-center">
      <p class="text-cream/30 text-xs font-body tracking-wide">
        &copy; {currentYear} Tsuki Mel Tattoo. All rights reserved.
      </p>
    </div>

  </div>
</footer>
