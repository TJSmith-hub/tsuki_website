---
// Replace these with your actual links
const BOOKING_URL = '#booking';
const INSTAGRAM_URL = 'https://instagram.com/tsuki_melx';
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-aubergine/80 border-b border-lavender-dark/20">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <a href="#hero" class="font-script text-3xl text-cream tracking-wide hover:text-lavender transition-colors leading-none">
      Tsuki Mel
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8 text-sm tracking-widest uppercase text-cream/70">
      <a href="#about" class="hover:text-lavender transition-colors">About</a>
      <a href="#black-grey" class="hover:text-lavender transition-colors">Black & Grey</a>
      <a href="#colour" class="hover:text-lavender transition-colors">Colour</a>
      <a href="#flash" class="hover:text-lavender transition-colors">Flash</a>
    </div>

    <!-- CTAs -->
    <div class="flex items-center gap-3">
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-2 text-cream/70 hover:text-lavender transition-colors text-sm"
        aria-label="Instagram"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        <span class="hidden lg:inline">Instagram</span>
      </a>
      <a
        href={BOOKING_URL}
        class="bg-linear-to-r from-lavender-dark to-rose-dust text-aubergine text-sm px-5 py-2 rounded-full hover:opacity-90 hover:shadow-lg hover:shadow-lavender-dark/30 transition-all font-medium tracking-wide"
      >
        Book Now
      </a>
    </div>

  </div>
</nav>

<!-- Mobile bottom nav -->
<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden backdrop-blur-md bg-aubergine/90 border-t border-lavender-dark/20 flex justify-around py-3 text-xs tracking-widest uppercase text-cream/60">
  <a href="#about" class="hover:text-lavender transition-colors px-3">About</a>
  <a href="#black-grey" class="hover:text-lavender transition-colors px-3">B&G</a>
  <a href="#colour" class="hover:text-lavender transition-colors px-3">Colour</a>
  <a href="#flash" class="hover:text-lavender transition-colors px-3">Flash</a>
  <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="hover:text-lavender transition-colors px-3" aria-label="Instagram">
    <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
    </svg>
  </a>
</div>
