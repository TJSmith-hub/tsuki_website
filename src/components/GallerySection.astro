---
import InkDivider from './InkDivider.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  id: string;
  title: string;
  description?: string;
  images: GalleryImage[];
  flip?: boolean;
}

const { id, title, description, images, flip = false } = Astro.props;
const placeholderCount = 6;
const bgClass = flip ? 'bg-aubergine-light' : 'bg-aubergine';
const waveColor = flip ? '#14101c' : '#3a2b4d';

const lightboxImages = await Promise.all(
  images.map(async (img) => {
    const full = await getImage({ src: img.src, width: 1600 });
    return { ...img, fullSrc: full.src };
  })
);
---

<section id={id} class={`relative ${bgClass} pt-20 pb-36 px-6 overflow-hidden`}>

  <!-- Background glows -->
  <div class="absolute top-1/2 left-1/4 w-[500px] h-[400px] bg-lavender-dark/12 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[300px] bg-rose-dust/8 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto">

    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <h2 class="font-heading text-5xl md:text-6xl font-light text-cream">{title}</h2>
      {description && (
        <p class="text-cream/50 font-body font-light text-base mt-4 max-w-md mx-auto">{description}</p>
      )}
      <div class="w-24 h-px bg-linear-to-r from-transparent via-lavender to-transparent mx-auto mt-8"></div>
    </div>

    <!-- Image grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
      {lightboxImages.length > 0 ? (
        lightboxImages.map((img, i) => (
          <button
            type="button"
            class="group aspect-square overflow-hidden rounded-xl border border-lavender/20 hover:border-lavender/50 focus-visible:border-lavender focus-visible:outline-none transition-colors cursor-pointer p-0 bg-transparent reveal reveal-scale"
            style={`--reveal-delay: ${(i % 6) * 70}ms`}
            data-lightbox-src={img.fullSrc}
            data-lightbox-alt={img.alt}
            aria-label={`View larger: ${img.alt}`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 33vw, 50vw"
            />
          </button>
        ))
      ) : (
        Array.from({ length: placeholderCount }).map((_, i) => (
          <div
            class="aspect-square rounded-xl bg-linear-to-br from-lavender-dark/15 via-lavender/10 to-rose-dust/15 border border-lavender/20 flex flex-col items-center justify-center gap-2 text-lavender/30 hover:border-lavender/50 hover:text-lavender/60 transition-all reveal reveal-scale"
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span class="text-xs font-body">Add photo</span>
          </div>
        ))
      )}
    </div>

  </div>

  <InkDivider fillColor={waveColor} flip={flip} />

</section>
